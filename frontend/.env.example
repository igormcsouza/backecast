# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix —
# lib/api.ts appends that). Copy this file to .env.local (gitignored) and
# adjust for your environment:
#
#   - Local dev against docker-compose's `api` service: the compose file
#     maps it to host port 8989 (see docker-compose.yml's `api.ports`), so
#     http://localhost:8989 is correct as-is.
#   - Against the deployed API (once infra/ is deployed, Phase 8): the API
#     Gateway invoke URL from `cdk deploy`'s stack outputs.
NEXT_PUBLIC_API_URL=http://localhost:8989
