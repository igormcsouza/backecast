# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix —
# lib/api.ts appends that). Copy this file to .env.local (gitignored) and
# adjust for your environment:
#
#   - Local dev against docker-compose's `api` service: the compose file
#     maps it to host port 8989 (see docker-compose.yml's `api.ports`), so
#     http://localhost:8989 is correct as-is.
#   - Against the deployed API (once infra/ is deployed, Phase 8): the API
#     Gateway invoke URL from `cdk deploy`'s stack outputs.
NEXT_PUBLIC_API_URL=http://localhost:8989

# Admin auth (Cognito) — see lib/auth.ts and infra/stacks/auth_stack.py.
#
# NEXT_PUBLIC_AUTH_STUB=1: skip the real Cognito login call and accept a
# fixed local username/password ("admin" / "local-dev-admin-password")
# instead. Only for local dev / the E2E suite — leave unset (or "0")
# against a real deployed environment.
NEXT_PUBLIC_AUTH_STUB=1

# Only needed when NEXT_PUBLIC_AUTH_STUB is unset — the deployed User
# Pool's client id and region (from `cdk deploy`'s AuthStack outputs).
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=sa-east-1
